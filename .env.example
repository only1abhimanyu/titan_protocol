# All optional. MasteryLoop runs fully without any of these, using authored content.
# Gemini (free tier is generous)
GEMINI_API_KEY=
# ...or any OpenAI-compatible endpoint
# OPENAI_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gemini-2.0-flash
# LLM_TIMEOUT=12
# Set to 1 to let item difficulties self-calibrate across sessions (off for clean demos)
CALIBRATE=0
